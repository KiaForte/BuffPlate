<style>
  /* ── Meal-time buttons ── */
  .meal-btn {
    font-family: inherit;
    font-size: .875rem;
    font-weight: 600;
    padding: 7px 18px;
    border-radius: 99px;
    border: 1.5px solid var(--inner);
    background: transparent;
    color: var(--fg-2);
    cursor: pointer;
    transition: background .12s, color .12s, border-color .12s;
  }
  .meal-btn.active {
    background: var(--dark);
    color: var(--dark-lt);
    border-color: var(--dark);
  }
  .meal-btn:hover:not(.active) { border-color: var(--dark); color: var(--fg); }

  /* ── Filter toggle button ── */
  .filter-toggle {
    font-family: inherit;
    font-size: .875rem;
    font-weight: 600;
    padding: 7px 18px;
    border-radius: 99px;
    border: 1.5px solid var(--inner);
    background: transparent;
    color: var(--fg-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background .12s, color .12s, border-color .12s;
  }
  .filter-toggle.active { border-color: var(--dark); color: var(--fg); }
  .filter-toggle .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--dark);
    display: none;
  }
  .filter-toggle.has-filters .dot { display: block; }

  /* ── Filter panel ── */
  .filter-panel {
    background: var(--card);
    border-radius: 16px;
    padding: 16px 20px;
    margin-bottom: 16px;
  }
  .filter-section-label {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--fg-2);
    margin-bottom: 8px;
  }
  .chip-row { display: flex; gap: 8px; flex-wrap: wrap; }

  .filter-chip {
    font-family: inherit;
    font-size: .8125rem;
    font-weight: 600;
    padding: 5px 13px;
    border-radius: 99px;
    cursor: pointer;
    transition: background .12s, color .12s, border-color .12s;
    white-space: nowrap;
  }
  .filter-chip.inclusion {
    border: 1.5px solid var(--inner);
    background: transparent;
    color: var(--fg-2);
  }
  .filter-chip.inclusion.active {
    background: #1F3B2D;
    color: #fff;
    border-color: #1F3B2D;
  }
  .filter-chip.exclusion {
    border: 1.5px solid #FCA5A5;
    background: transparent;
    color: #991B1B;
  }
  .filter-chip.exclusion.active {
    background: #FEE2E2;
    border-color: #EF4444;
    color: #991B1B;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .filter-chip.exclusion       { border-color: #7F1D1D; color: #FCA5A5; }
    :root:not([data-theme="light"]) .filter-chip.exclusion.active { background: #450A0A; border-color: #B91C1C; color: #FCA5A5; }
  }
  :root[data-theme="dark"] .filter-chip.exclusion       { border-color: #7F1D1D; color: #FCA5A5; }
  :root[data-theme="dark"] .filter-chip.exclusion.active { background: #450A0A; border-color: #B91C1C; color: #FCA5A5; }

  /* ── Station accordions ── */
  details.station { margin-bottom: 10px; border-radius: 16px; overflow: hidden; }
  details.station > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    background: var(--card);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--fg-2);
    cursor: pointer;
    user-select: none;
    border-radius: 16px;
  }
  details.station[open] > summary { border-radius: 16px 16px 0 0; border-bottom: 1px solid var(--inner); }
  details.station > summary::-webkit-details-marker { display: none; }
  details.station > summary .chevron {
    font-size: .875rem;
    transition: transform .15s;
  }
  details.station[open] > summary .chevron { transform: rotate(180deg); }
  details.station > .station-body { background: var(--card); border-radius: 0 0 16px 16px; }
  .item-row {
    display: flex; align-items: center; gap: 12px;
    min-height: 68px; padding: 12px 16px;
    border-top: 1px solid var(--inner);
  }
  .section-label {
    font-size: .8125rem; font-weight: 600;
    color: var(--fg-2); padding: 8px 16px 2px;
    letter-spacing: .03em;
  }
  .no-items-msg {
    padding: 18px 16px; font-size: .875rem;
    color: var(--fg-2); text-align: center; font-style: italic;
  }
</style>

<div class="page">

  {{!-- Hall picker --}}
  <div style="margin-bottom: 18px;">
    <p style="font-size: .8125rem; font-weight: 500; color: var(--fg-2); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px;">Dining Halls</p>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      {{#each halls}}
        {{#if live}}
          <button style="font-family:inherit;font-size:.875rem;font-weight:600;padding:7px 16px;border-radius:99px;border:none;background:var(--dark);color:var(--dark-lt);cursor:default;">{{displayName}}</button>
        {{else}}
          <button disabled style="font-family:inherit;font-size:.875rem;font-weight:500;padding:7px 16px;border-radius:99px;border:1.5px solid var(--inner);background:transparent;color:var(--fg-2);cursor:not-allowed;display:flex;align-items:center;gap:6px;">
            {{displayName}}<span style="font-size:.75rem;opacity:.65;">Coming soon</span>
          </button>
        {{/if}}
      {{/each}}
    </div>
  </div>

  {{!-- Meal-time + filter row --}}
  {{#unless error}}
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:18px;">
      <button class="meal-btn" data-meal="breakfast">Breakfast</button>
      <button class="meal-btn" data-meal="lunch">Lunch</button>
      <button class="meal-btn" data-meal="dinner">Dinner</button>
      {{#if inclusionTags}}{{else}}{{#if exclusionTags}}{{else}}{{/if}}{{/if}}
      {{#if inclusionTags}}
        <button class="filter-toggle" id="filter-toggle" style="margin-left:auto;">
          <span class="dot"></span>Filters ▾
        </button>
      {{else}}
        {{#if exclusionTags}}
          <button class="filter-toggle" id="filter-toggle" style="margin-left:auto;">
            <span class="dot"></span>Filters ▾
          </button>
        {{/if}}
      {{/if}}
    </div>

    {{!-- Filter panel (hidden until toggled) --}}
    <div class="filter-panel" id="filter-panel" hidden>
      {{#if inclusionTags}}
        <div style="margin-bottom:{{#if exclusionTags}}14px{{else}}0{{/if}};">
          <p class="filter-section-label">Show only</p>
          <div class="chip-row">
            {{#each inclusionTags}}
              <button class="filter-chip inclusion" data-filter-tag="{{this}}" data-filter-type="inclusion">{{this}}</button>
            {{/each}}
          </div>
        </div>
      {{/if}}
      {{#if exclusionTags}}
        <div>
          <p class="filter-section-label">Hide allergens</p>
          <div class="chip-row">
            {{#each exclusionTags}}
              <button class="filter-chip exclusion" data-filter-tag="{{this}}" data-filter-type="exclusion">{{this}}</button>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </div>
  {{/unless}}

  {{!-- Date header --}}
  <header style="margin-bottom:18px;">
    <h1 style="font-family:'Fraunces',Georgia,serif;font-size:2rem;font-weight:500;letter-spacing:-.01em;">{{date}}</h1>
  </header>

  {{#if error}}
    <div style="background:#FEF3C7;border:1px solid #FCD34D;border-radius:16px;padding:20px 24px;color:#78350F;">
      <div style="font-weight:600;margin-bottom:4px;">Menu unavailable</div>
      <div style="font-size:.9rem;">{{error}}</div>
    </div>
  {{else if noItems}}
    <div class="card" style="padding:32px;text-align:center;color:var(--fg-2);">No menu data available for today.</div>
  {{else}}
    <div id="station-list">
      {{#each stations}}
        <details class="station" data-station data-meal-times="{{json mealTimes}}">
          <summary>{{station}}<span class="chevron">▾</span></summary>
          <div class="station-body">
            {{#each sections}}
              {{#if section}}<div class="section-label">{{section}}</div>{{/if}}
              {{#each items}}
                <div class="item-row" data-item data-item-tags="{{json tags}}">
                  <div style="flex:1;min-width:0;">
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                      <span style="font-size:15px;font-weight:500;">{{name}}</span>
                      {{#each tags}}
                        <span style="font-size:11px;font-weight:600;padding:2px 7px;border-radius:9px;background:var(--dark-lt);color:var(--dark);white-space:nowrap;">{{this}}</span>
                      {{/each}}
                    </div>
                    {{#if servingText}}<div style="font-size:12px;color:var(--fg-2);margin-top:2px;">per {{servingText}}</div>{{/if}}
                  </div>
                  <div style="text-align:right;flex-shrink:0;">
                    <div style="font-size:15px;font-weight:600;font-variant-numeric:tabular-nums;">{{roundVal calories}} kcal</div>
                    <div style="font-size:12px;color:var(--fg-2);margin-top:2px;font-variant-numeric:tabular-nums;white-space:nowrap;">
                      P {{roundVal protein}}g &nbsp;·&nbsp; C {{roundVal carbs}}g &nbsp;·&nbsp; F {{roundVal fat}}g
                    </div>
                  </div>
                </div>
              {{/each}}
            {{/each}}
            <div class="no-items-msg" hidden>No matching items in this station.</div>
          </div>
        </details>
      {{/each}}
    </div>
  {{/if}}

</div>

<script>
(function () {
  let selectedMeal = null;
  const selectedInc = new Set();
  const selectedExc = new Set();

  // ── Meal-time buttons ────────────────────────────────────────────────────
  document.querySelectorAll('.meal-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const meal = btn.dataset.meal;
      if (selectedMeal === meal) {
        selectedMeal = null;
        btn.classList.remove('active');
      } else {
        selectedMeal = meal;
        document.querySelectorAll('.meal-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
      applyFilters();
    });
  });

  // ── Filter panel toggle ───────────────────────────────────────────────────
  const filterToggle = document.getElementById('filter-toggle');
  const filterPanel  = document.getElementById('filter-panel');
  if (filterToggle && filterPanel) {
    filterToggle.addEventListener('click', () => {
      filterPanel.hidden = !filterPanel.hidden;
      filterToggle.classList.toggle('active', !filterPanel.hidden);
    });
  }

  // ── Filter chips ──────────────────────────────────────────────────────────
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const tag  = chip.dataset.filterTag;
      const type = chip.dataset.filterType;
      const set  = type === 'inclusion' ? selectedInc : selectedExc;
      if (set.has(tag)) { set.delete(tag); chip.classList.remove('active'); }
      else              { set.add(tag);    chip.classList.add('active'); }
      if (filterToggle) filterToggle.classList.toggle('has-filters', selectedInc.size > 0 || selectedExc.size > 0);
      applyFilters();
    });
  });

  // ── Core filter logic ────────────────────────────────────────────────────
  function applyFilters() {
    document.querySelectorAll('[data-station]').forEach(station => {
      // Meal-time gate: hide station if it doesn't serve the selected meal
      const mealTimes = JSON.parse(station.dataset.mealTimes || '[]');
      if (selectedMeal && !mealTimes.includes(selectedMeal)) {
        station.hidden = true;
        return;
      }

      const itemEls = station.querySelectorAll('[data-item]');
      let visible = 0;
      itemEls.forEach(item => {
        const tags     = JSON.parse(item.dataset.itemTags || '[]');
        const excluded = selectedExc.size > 0 && tags.some(t => selectedExc.has(t));
        const included = selectedInc.size === 0 || tags.some(t => selectedInc.has(t));
        const show     = included && !excluded;
        item.hidden = !show;
        if (show) visible++;
      });

      const noMsg = station.querySelector('.no-items-msg');
      if (noMsg) noMsg.hidden = visible > 0;
      const anyFilter = selectedMeal || selectedInc.size > 0 || selectedExc.size > 0;
      station.hidden = anyFilter && visible === 0;
    });
  }
})();
</script>
